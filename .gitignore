# Runtime output (mock-наліпки, надруковані PNG, тимчасові тест-скрипти)
output/*
!output/.gitkeep

# Python
__pycache__/
*.py[cod]

# Локальні перевизначення compose (за потреби)
docker-compose.override.yml

# OS
.DS_Store
Thumbs.db
desktop.ini

# Секрети і логи: репозиторій публічний, тож помилка `git add -A` тут
# видна всім одразу. .env у проєкті поки не використовується — правило
# стоїть саме тому, що з'явиться він тихо.
.env
.env.*
!.env.example
*.log
